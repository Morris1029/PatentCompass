# Copy to api/.env. Values below are for local development only.
DATABASE_URL=postgresql+psycopg://patentcompass:patentcompass_dev@127.0.0.1:15432/patentcompass
REDIS_URL=redis://127.0.0.1:16379/0
# Relative paths resolve from api/; Docker overrides this with /workspace/storage.
STORAGE_ROOT=../storage

# Optional OpenAI-compatible model endpoints. Leave unset to disable AI features.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
